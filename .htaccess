# Deny directory listing
Options -Indexes

# Deny access to dotfiles (hidden files) except allow this .htaccess
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<Files ".htaccess">
  Require all granted
</Files>

# Deny access to markdown, SQL, env and editor/backup files
<FilesMatch "\.(md|MD|sql|env|bak|old|swp|swo|~)$">
  Require all denied
</FilesMatch>

# Deny access to some config/sample files and lock/manifest files
<FilesMatch "^(config|config\.local|config\.php|composer\.json|composer\.lock|\.env)$">
  Require all denied
</FilesMatch>

# Explicitly prevent access to git internals
RedirectMatch 404 \/\.git

# Block direct requests to the /sql directory.
# fleet.svg keeps its name. A request without ?v= is sent to the versioned URL.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^sql/ - [F,L,NC]
  RewriteCond %{QUERY_STRING} !(^|&)v=
  RewriteRule ^diplomacy/board/assets/fleet\.svg$ /diplomacy/board/assets/fleet.svg?v=1792443899 [R=302,L]
</IfModule>

# Security headers (optional, harmless if supported)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
